<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Private-LAN requests use a native bridge with literal private-IP validation.
         Their payloads are authenticated and encrypted with the pairing AES key.
         The WebView is not allowed to load external HTTP content. -->
    <base-config cleartextTrafficPermitted="true"><trust-anchors><certificates src="system" /></trust-anchors></base-config>
</network-security-config>
