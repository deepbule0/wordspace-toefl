{
  "name": "wordspace-toefl",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "description": "Wordspace: local TOEFL vocabulary practice, Android app and encrypted LAN sync",
  "engines": { "node": ">=22" },
  "scripts": {
